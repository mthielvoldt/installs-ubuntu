#!/bin/bash
# sandbox.sh - Entry point
# Usage: ./sandbox.sh [command [args...]]

set -euo pipefail

export SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export COMMAND="${*:-bash}"
export RESOLV_CONF="$SCRIPT_DIR/resolv_conf"
export SLIRP_READY=slirp_ready
export INNER_PID_FILE=inner_pid
touch $INNER_PID_FILE $SLIRP_READY $RESOLV_CONF
chmod 666 "$RESOLV_CONF" "$SLIRP_READY" "$INNER_PID_FILE"
ls -la $INNER_PID_FILE

cleanup() {
  echo "cleaning up..."
  rm -f "$RESOLV_CONF" "$SLIRP_READY" "$INNER_PID_FILE"
}
trap cleanup EXIT

echo "nameserver 10.0.2.3" > "$RESOLV_CONF"
echo "[sandbox] Starting..."

sudo --preserve-env=SCRIPT_DIR,RESOLV_CONF,SLIRP_READY,INNER_PID_FILE,COMMAND \
  unshare --user --map-root-user bash sandbox-outer.sh
