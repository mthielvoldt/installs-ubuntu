# This profile addresses when launching bwrap ->
# "Child process exited with code 1: bwrap: setting up uid map: Permission denied"
abi <abi/4.0>,
include <tunables/global>

# Allow bubblewrap to use unprivileged user namespaces
profile bwrap /{home/mike/,usr/}bin/bwrap flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/bwrap>
}
